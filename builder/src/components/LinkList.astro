---
import { label, type LinkItem } from '../lib/content';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  items?: LinkItem[];
}
const { lang, items = [] } = Astro.props;
const external = (url: string) => /^https?:/.test(url);
---

<ul class="links">
  {
    items.map((item) => (
      <li>
        <a href={item.url} {...(external(item.url) ? { rel: 'noopener', target: '_blank' } : {})}>
          {label(item, lang)}
        </a>
        {item.value && <span class="value">{item.value}</span>}
      </li>
    ))
  }
</ul>

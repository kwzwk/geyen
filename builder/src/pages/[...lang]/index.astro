---
import Base from '../../layouts/Base.astro';
import HeadlineList from '../../components/HeadlineList.astro';
import EventList from '../../components/EventList.astro';
import OpenNowScript from '../../components/OpenNowScript.astro';
import DepartureTable from '../../components/DepartureTable.astro';
import TransitScript from '../../components/TransitScript.astro';
import { transit, nextDepartures, toKoeln, clock, type Departure } from '../../lib/transit';
import { t, href, langPaths, toLang } from '../../lib/i18n';
import { allHeadlines, highlighted, events, shops, links, label } from '../../lib/content';

export const getStaticPaths = langPaths;
const lang = toLang(Astro.params.lang);
const ui = t(lang);
// Headlines mentioning Geyen first, then the newest of the rest.
const headlines = [...highlighted, ...allHeadlines.filter((h) => !highlighted.includes(h))].slice(0, 8);
const withHours = shops.filter((s) => s.week);
const nextEvent = events[0];
const dayMonth = (iso: string) =>
  new Intl.DateTimeFormat('de-DE', { timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit' }).format(new Date(iso));
// Everything TransitScript needs to judge a Köln connection: delays, the change and the arrival.
const connAttrs = (d: Departure) => ({
  'data-t': d.t,
  'data-k': d.k,
  'data-kb': d.conn?.kb,
  'data-kd': d.conn?.kd,
  'data-ka': d.conn?.ka,
  'data-bus-arr': d.conn?.busArr,
  'data-dep': d.conn?.dep,
  'data-arr': d.conn?.arr,
});
// Readouts render enough upcoming rows for the build interval; TransitScript shows the first one not yet gone.
const READOUT_ROWS = 40;
const alarm = new Set(['112', '110']);
const external = (url: string) => (/^https?:/.test(url) ? { rel: 'noopener', target: '_blank' } : {});
// Social profile labels read "Name auf Instagram"; the tile shows the network as a tag.
const network = (url: string) => (/instagram/.test(url) ? 'Instagram' : /facebook/.test(url) ? 'Facebook' : null);
const profile = (text: string) => text.replace(/\s+(auf|on)\s+(Instagram|Facebook)$/i, '');
const icon = {
  news: 'M4 5h13v14H6a2 2 0 0 1-2-2V5zM17 9h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5',
  cal: 'M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM4 10h16M9 3v4M15 3v4',
  shop: 'M4 9l1.5-5h13L20 9M4 9h16v11H4zM9 20v-6h6v6',
  bus: 'M7 3h10a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3zM4 11h16M8 21l1-4M16 21l-1-4',
  sos: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
  link: 'M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1 1M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1-1',
};
---

<Base lang={lang} slug="">
  <section class="hero">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <span class="pill"><span class="live-dot still"></span>{ui.heroPill}</span>
        <h1>{ui.heroTitle.map((line) => <span>{line}</span>)}</h1>
        <p class="lead">{ui.heroLead}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={href(lang, 'verkehr')}>{ui.heroBuses} <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={href(lang, 'aktuelles')}>{ui.heroNews}</a>
        </div>
      </div>
      {
        transit && (
          <div class="stack">
            <a class="float float-dep" href={href(lang, 'verkehr')}>
              <div class="float-head">
                {transit.realtime && <span class="live-dot" />}
                {ui.nextBuses}
              </div>
              <ul class="mini-dep" data-departures data-limit="4">
                {nextDepartures.slice(0, READOUT_ROWS).map((d, i) => (
                  <li data-t={d.t} data-k={d.k} hidden={i >= 4}>
                    <span class="t">
                      <span data-live={d.k}>{clock(d.t)}</span>
                    </span>
                    <span class={`line line-${d.mode}`}>{d.line}</span>
                    <span class="dest">{d.headsign}</span>
                    <span class="in" data-in />
                  </li>
                ))}
                <li class="empty" data-departures-empty hidden={nextDepartures.length > 0}>{ui.noDepartures}</li>
              </ul>
            </a>
            {withHours.length > 0 && (
              <a class="float float-open" href={href(lang, 'einkaufen')} aria-hidden="true" tabindex="-1">
                <div class="float-head">
                  {ui.openNow}
                  <span class="grow" />
                  <small>
                    <span data-open-count>–</span> / {withHours.length}
                  </small>
                </div>
                <ul class="mini-open" data-open-only hidden>
                  {withHours.map((s) => (
                    <li data-hours={JSON.stringify(s.week)}>
                      <span class="live-dot still" />
                      {s.name}
                      <span class="m">{ui.categories[s.category] ?? s.category}</span>
                    </li>
                  ))}
                </ul>
                <p class="empty" data-none-open hidden>{ui.noneOpen}</p>
              </a>
            )}
            {toKoeln.length > 0 && (
              <div class="float float-chip" aria-hidden="true" data-departures data-limit="1" data-pick="arrival">
                {toKoeln.slice(0, READOUT_ROWS).map((d, i) => (
                  <div {...connAttrs(d)} hidden={i > 0}>
                    <div class="chip-label">{ui.arrivalCologne}</div>
                    <div class="chip-big">
                      <span data-live={d.conn!.ka}>{clock(d.conn!.arr)}</span>
                    </div>
                    <div class="chip-route">
                      <span class={`line line-${d.mode}`}>{d.line}</span>
                      {d.conn!.line && <span class={`line line-${d.conn!.mode}`}>{d.conn!.line}</span>}
                      <span>{d.conn!.dest}</span>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )
      }
    </div>
    <div class="wrap">
      <div class="metrics">
        {
          transit && (
            <div data-departures data-limit="1" data-pick="next">
              {nextDepartures.slice(0, READOUT_ROWS).map((d, i) => (
                <a class="metric" href={href(lang, 'verkehr')} data-t={d.t} data-k={d.k} hidden={i > 0}>
                  <span class="k">{ui.nextBus}</span>
                  <span class="v">
                    <span data-live={d.k}>{clock(d.t)}</span>
                  </span>
                  <span class="s">
                    {d.line} → {d.headsign} <span data-in />
                  </span>
                </a>
              ))}
            </div>
          )
        }
        {
          toKoeln.length > 0 && (
            <div data-departures data-limit="1" data-pick="arrival">
              {toKoeln.slice(0, READOUT_ROWS).map((d, i) => (
                <a class="metric" href={href(lang, 'verkehr')} {...connAttrs(d)} hidden={i > 0}>
                  <span class="k">{ui.toCologne}</span>
                  <span class="v">
                    <span data-live={d.conn!.ka}>{clock(d.conn!.arr)}</span>
                  </span>
                  <span class="s">
                    {ui.arrivalShort} {d.conn!.dest} · {ui.departsShort} {clock(d.t)} <span data-in />
                  </span>
                </a>
              ))}
            </div>
          )
        }
        {
          withHours.length > 0 && (
            <div>
              <a class="metric" href={href(lang, 'einkaufen')}>
                <span class="k">{ui.openNow}</span>
                <span class="v">
                  <span data-open-count>–</span> / {withHours.length}
                </span>
                <span class="s">{ui.shopsOpen}</span>
              </a>
            </div>
          )
        }
        {
          nextEvent && (
            <div>
              <a class="metric" href={href(lang, 'termine')}>
                <span class="k">{ui.nextEvent}</span>
                <span class="v">{dayMonth(nextEvent.date)}</span>
                <span class="s">{nextEvent.title}</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow">{ui.todayEyebrow}</p>
    <h2 class="big">{ui.todayTitle} <em>{ui.todayTitleMuted}</em></h2>

    <div class="bento">
      <section class="card c-4">
        <div class="card-head">
          <span class="icon i-news"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.news} /></svg></span>
          <h2>{ui.latestHeadlines}</h2>
        </div>
        <HeadlineList lang={lang} items={headlines.slice(0, 5)} />
        <p class="more"><a href={href(lang, 'aktuelles')}>{ui.allNews} <span class="arrow">→</span></a></p>
      </section>

      <section class="card c-2">
        <div class="card-head">
          <span class="icon i-cal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.cal} /></svg></span>
          <h2>{ui.nextEvents}</h2>
        </div>
        <EventList lang={lang} items={events.slice(0, 3)} />
        <p class="more"><a href={href(lang, 'termine')}>{ui.allEvents} <span class="arrow">→</span></a></p>
      </section>

      <section class="card c-2">
        <div class="card-head">
          <span class="icon i-shop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.shop} /></svg></span>
          <h2>{ui.openNowList}</h2>
        </div>
        <ul class="open-now" data-open-only hidden>
          {
            withHours.map((s) => (
              <li data-hours={JSON.stringify(s.week)}>
                <span class="avatar" aria-hidden="true">{s.name.charAt(0)}</span>
                <span>{s.name}</span>
                <span class="meta">{ui.categories[s.category] ?? s.category}</span>
              </li>
            ))
          }
        </ul>
        <p class="empty" data-none-open hidden>{ui.noneOpen}</p>
        <p class="muted" data-needs-js>{ui.needsJs}</p>
        <p class="more"><a href={href(lang, 'einkaufen')}>{ui.allShops} <span class="arrow">→</span></a></p>
      </section>

      {
        transit && (
          <section class="card c-4">
            <div class="card-head">
              <span class="icon i-bus">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={icon.bus} />
                </svg>
              </span>
              <h2>{ui.nextBuses}</h2>
              {transit.realtime && (
                <span class="meta">
                  <span class="live-dot" />
                  <span data-live-status hidden />
                </span>
              )}
            </div>
            <DepartureTable lang={lang} rows={nextDepartures} limit={4} variant="home" />
            <p class="more"><a href={href(lang, 'verkehr')}>{ui.allDepartures} <span class="arrow">→</span></a></p>
          </section>
        )
      }

      <section class="card c-2">
        <div class="card-head">
          <span class="icon i-sos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.sos} /></svg></span>
          <h2>{ui.emergency}</h2>
        </div>
        <div class="sos">
          {
            (links.emergency ?? []).map((item) => (
              <a class:list={{ alarm: alarm.has(item.value ?? '') }} href={item.url} {...external(item.url)}>
                <b>{item.value ?? '↗'}</b>
                <span>{label(item, lang)}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="card c-4">
        <div class="card-head">
          <span class="icon i-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.link} /></svg></span>
          <h2>{ui.followOnline}</h2>
        </div>
        <div class="follow">
          {
            (links.social ?? []).map((item) => (
              <a href={item.url} {...external(item.url)}>
                {network(item.url) && <span class="tag">{network(item.url)}</span>}
                {profile(label(item, lang))}
              </a>
            ))
          }
        </div>
      </section>
    </div>

    <div class="band">
      <h2>{ui.bandTitle} <span>{ui.bandAccent}</span></h2>
      <p>{ui.bandText}</p>
      <div class="band-points">
        {
          ui.bandPoints.map(([title, text]) => (
            <div>
              <b>{title}</b>
              {text}
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <OpenNowScript lang={lang} />
  {transit && <TransitScript lang={lang} live={!!transit?.realtime} />}
</Base>

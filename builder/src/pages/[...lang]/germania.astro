---
import Base from '../../layouts/Base.astro';
import HeadlineList from '../../components/HeadlineList.astro';
import LinkList from '../../components/LinkList.astro';
import { t, langPaths, toLang } from '../../lib/i18n';
import { newsBySource, links } from '../../lib/content';

export const getStaticPaths = langPaths;
const lang = toLang(Astro.params.lang);
const ui = t(lang);
const club = newsBySource.find((s) => s.id === 'germania');
---

<Base lang={lang} slug="germania" title="SC Germania 1932 Geyen">
  <h1>SC Germania 1932 Geyen e.V.</h1>
  <p class="lead">{ui.germaniaNote}</p>
  <div class="grid">
    <section class="card">
      <h2>{ui.germaniaLinks}</h2>
      <LinkList lang={lang} items={links.germania} />
    </section>
    <section class="card">
      <h2>{ui.germaniaNews}</h2>
      <HeadlineList lang={lang} items={club?.items ?? []} showSource={false} />
    </section>
  </div>
</Base>

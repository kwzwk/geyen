---
import Base from '../../layouts/Base.astro';
import { t, langPaths, toLang } from '../../lib/i18n';
import { site } from '../../lib/content';

export const getStaticPaths = langPaths;
const lang = toLang(Astro.params.lang);
const ui = t(lang);
const i = site.impressum ?? ({} as typeof site.impressum);
---

<Base lang={lang} slug="impressum" title={ui.impressum}>
  <h1>Impressum</h1>
  {lang === 'en' && <p class="lead">The legal notice is provided in German, as required by German law.</p>}
  <section class="card prose" lang="de">
    <h2>Kontakt</h2>
    <p>
      E-Mail: <a href={`mailto:${i.email}`}>{i.email}</a>
      {i.phone && (<><br />Telefon: {i.phone}</>)}
    </p>
    <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
    <p>{i.name}</p>
    <h2>Hinweis zu Inhalten Dritter</h2>
    <p>
      geyen.org ist ein privates, nicht kommerzielles Verzeichnis. Die Seite zeigt Schlagzeilen, Termine und
      Kontaktdaten nur als Verweise und verlinkt jeweils auf die Originalquelle. Für die Inhalte der verlinkten
      Seiten sind ausschließlich deren Betreiber verantwortlich. Sollten Sie als Urheber einen Verweis nicht
      wünschen, genügt eine kurze Nachricht an die oben genannte E-Mail-Adresse; der Eintrag wird dann entfernt.
    </p>
  </section>
</Base>

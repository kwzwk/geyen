---
import Base from '../../layouts/Base.astro';
import DepartureTable from '../../components/DepartureTable.astro';
import TransitScript from '../../components/TransitScript.astro';
import LinkList from '../../components/LinkList.astro';
import { t, langPaths, toLang, NAV, formatDate } from '../../lib/i18n';
import { transit, departuresAt, toKoeln } from '../../lib/transit';
import { links } from '../../lib/content';

export const getStaticPaths = langPaths;
const lang = toLang(Astro.params.lang);
const ui = t(lang);
const title = NAV.find((n) => n.slug === 'verkehr')![lang];
---

<Base lang={lang} slug="verkehr" title={title}>
  <h1>{title}</h1>
  <p class="lead">{transit?.realtime ? ui.liveNote : ui.scheduleNote}</p>
  {
    transit ? (
      <>
        {transit.realtime && (
          <p class="live-status">
            <span class="pill">
              <span class="live-dot" />
              <span data-live-status hidden />
            </span>
          </p>
        )}
        <section class="card">
          <div class="card-head">
            <span class="icon i-bus">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 3h10a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3zM4 11h16M8 21l1-4M16 21l-1-4" />
              </svg>
            </span>
            <h2>{ui.toCologne}</h2>
          </div>
          <p class="muted small">{ui.toCologneLead}</p>
          <DepartureTable lang={lang} rows={toKoeln} limit={6} variant="koeln" />
        </section>
        <div class="grid">
          {transit.stops.map((stop) => (
            <section class="card">
              <div class="card-head">
                <span class="avatar" aria-hidden="true">{stop.name.charAt(0)}</span>
                <h2>{stop.name}</h2>
                <span class="meta">
                  {stop.lines.map((l) => (
                    <span class="line line-bus">{l}</span>
                  ))}
                </span>
              </div>
              <DepartureTable lang={lang} rows={departuresAt(stop.name)} limit={6} variant="stop" />
              {stop.live && (
                <p class="more">
                  <a href={stop.live} rel="noopener" target="_blank">
                    {ui.liveDepartures} <span class="arrow">↗</span>
                  </a>
                </p>
              )}
            </section>
          ))}
        </div>
        <p class="muted small">
          {transit.attributionUrl ? (
            <a href={transit.attributionUrl} rel="noopener" target="_blank">
              {transit.attribution}
            </a>
          ) : (
            transit.attribution
          )}
          {transit.timetableDate && ` · ${formatDate(lang, transit.timetableDate)}`}
          {transit.realtime && (
            <>
              {' · '}
              {transit.realtime.attributionUrl ? (
                <a href={transit.realtime.attributionUrl} rel="noopener" target="_blank">
                  {transit.realtime.attribution}
                </a>
              ) : (
                transit.realtime.attribution
              )}
            </>
          )}
        </p>
      </>
    ) : (
      <p class="card empty">{ui.noTimetable}</p>
    )
  }
  <section class="card">
    <h2>{ui.journeyPlanner}</h2>
    <LinkList lang={lang} items={links.transit} />
  </section>
  <TransitScript lang={lang} live={!!transit?.realtime} />
</Base>

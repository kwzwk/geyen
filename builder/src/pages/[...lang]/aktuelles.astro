---
import Base from '../../layouts/Base.astro';
import HeadlineList from '../../components/HeadlineList.astro';
import { t, langPaths, toLang, NAV } from '../../lib/i18n';
import { allHeadlines, highlighted, sources } from '../../lib/content';

export const getStaticPaths = langPaths;
const lang = toLang(Astro.params.lang);
const ui = t(lang);
const title = NAV.find((n) => n.slug === 'aktuelles')![lang];
const region = allHeadlines.filter((h) => !highlighted.includes(h)).slice(0, 40);
---

<Base lang={lang} slug="aktuelles" title={title}>
  <h1>{title}</h1>
  <p class="lead">{ui.externalNote}</p>
  <div class="grid">
    {
      highlighted.length > 0 && (
        <section class="card span-2">
          <h2>{ui.fromGeyen}</h2>
          <HeadlineList lang={lang} items={highlighted} />
        </section>
      )
    }
    <section class="card span-2">
      <h2>{ui.fromRegion}</h2>
      <HeadlineList lang={lang} items={region} />
    </section>
    <section class="card">
      <h2>{ui.newsSources}</h2>
      <ul class="links">
        {
          (sources.feeds ?? []).map((src) => (
            <li>
              <a href={src.homepage} rel="noopener" target="_blank">
                {src.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

---
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import { NAV, t, href, formatDate, type Lang } from '../lib/i18n';
import { site, status } from '../lib/content';

interface Props {
  lang: Lang;
  slug: string;
  title?: string;
}
const { lang, slug, title } = Astro.props;
const ui = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const pageTitle = title ? `${title} – ${site.title}` : `${site.title} – ${ui.tagline}`;
const canonical = new URL(href(lang, slug), Astro.site);
// The home page draws its own hero; every other page gets a softer gradient at the top.
const isHome = slug === '' && !title;
const navLabel = lang === 'de' ? 'Hauptnavigation' : 'Main navigation';
const pick = (slugs: string[]) => NAV.filter((n) => slugs.includes(n.slug));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={ui.tagline} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={new URL(href('de', slug), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', slug), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050506" media="(prefers-color-scheme: dark)" />
  </head>
  <body class:list={{ 'page-sub': !isHome }}>
    <a class="skip" href="#main">{ui.skip}</a>
    {!isHome && <div class="mesh mesh-page" aria-hidden="true" />}
    <header class="site-header">
      <div class="wrap">
        <div class="bar">
          <a class="brand" href={href(lang, '')}><span class="logo" aria-hidden="true">G</span>Geyen</a>
          <nav class="nav nav-main" aria-label={navLabel}>
            <ul>
              {
                NAV.map((item) => (
                  <li>
                    <a href={href(lang, item.slug)} aria-current={item.slug === slug ? 'page' : undefined}>
                      {item[lang]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="bar-end">
            <a class="lang" href={href(other, slug)} hreflang={other} lang={other}>{ui.switchLang}</a>
            <details class="menu">
              <summary aria-label={ui.menu}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16"></path>
                </svg>
              </summary>
              <nav class="nav" aria-label={navLabel}>
                <ul>
                  {
                    NAV.map((item) => (
                      <li>
                        <a href={href(lang, item.slug)} aria-current={item.slug === slug ? 'page' : undefined}>
                          {item[lang]}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </nav>
            </details>
          </div>
        </div>
      </div>
    </header>
    <main id="main" class:list={{ wrap: !isHome }}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="brand" href={href(lang, '')}><span class="logo" aria-hidden="true">G</span>Geyen</a>
            <p>{ui.footerNote}</p>
          </div>
          <div>
            <h2>{ui.footVillage}</h2>
            <ul>{pick(['aktuelles', 'germania', 'termine', 'dorf']).map((n) => <li><a href={href(lang, n.slug)}>{n[lang]}</a></li>)}</ul>
          </div>
          <div>
            <h2>{ui.footEveryday}</h2>
            <ul>{pick(['einkaufen', 'verkehr', 'kontakt']).map((n) => <li><a href={href(lang, n.slug)}>{n[lang]}</a></li>)}</ul>
          </div>
          <div>
            <h2>{ui.legal}</h2>
            <ul>
              <li><a href={href(lang, 'impressum')}>{ui.impressum}</a></li>
              <li><a href={href(lang, 'datenschutz')}>{ui.privacy}</a></li>
              <li><a href={href(other, slug)} hreflang={other} lang={other}>{ui.switchLang}</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-base">
          {status.fetchedAt ? <span>{ui.updated}: {formatDate(lang, status.fetchedAt)}</span> : <span />}
          <span>50259 Pulheim-Geyen</span>
        </div>
      </div>
    </footer>
  </body>
</html>
